# Dockerfile.plugin — generic plugin builder, parameterized by build arg PLUGIN_DIR.
#
# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /workspace

RUN apk add --no-cache git ca-certificates

ARG PLUGIN_DIR=etf

# Copy workspace manifests. go.work `use`s every workspace module, so each
# module's go.mod must be present even when only one plugin is built.
COPY go.mod go.mod
COPY go.work go.work.sum ./
COPY plugins/etf/go.mod ./plugins/etf/go.mod
COPY plugins/macro/go.mod ./plugins/macro/go.mod
COPY plugins/crypto/go.mod ./plugins/crypto/go.mod

# Shared root-module packages the plugins import (pluginrunner, proto stubs).
COPY pkg/ ./pkg/

# Copy the specific plugin (overwrites its go.mod stub from above).
COPY plugins/${PLUGIN_DIR}/ ./plugins/${PLUGIN_DIR}/

# Build the plugin binary (path: plugins/<name>/cmd/<name>/main.go)
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" \
    -o /bin/plugin ./plugins/${PLUGIN_DIR}/cmd/${PLUGIN_DIR}

# Runtime stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /bin/plugin /bin/plugin

ENTRYPOINT ["/bin/plugin"]
