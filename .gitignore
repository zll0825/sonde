# OS junk
.DS_Store

# Go build artifacts
/bin/
tmp/
*.test
*.out
*.exe
*.coverprofile

# Python bytecode (Trellis scripts)
__pycache__/
*.pyc

# Node (web/, from M5 on)
node_modules/
.next/

# Local environment / secrets
.env
.env.*
!.env.example

# Agent tooling — local only. Trellis / Claude / Codex / Pi regenerate these.
# A leading "./trellis" does NOT match ".trellis/"; already-tracked files also
# ignore gitignore until they are removed from the index (`git rm --cached`).
.trellis/
.agents/
.claude/
.codex/
.pi/
.idea/
.agent/
.grok/
.meituan-catpaw/
AGENTS.md
CLAUDE.md

# Logs
*.log

# Root-level binaries from `go build -o`
/api
/core
